# Southeast Asia Haze Watch: environment variables
# Copy to .env.local for development. Nothing here is required to run the site:
# with no variables set, the connected public sources still work.

# Public site URL, used for canonical links, the sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Corrections contact shown in the footer and on /about. Left empty, the site says it is not configured.
NEXT_PUBLIC_CORRECTIONS_EMAIL=

# Map tiles. Defaults to CARTO dark basemap (OpenStreetMap data). Review CARTO's terms before production
# traffic, or point this at your own tile service.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=

# --- Server-only secrets (never prefix with NEXT_PUBLIC_) -------------------------------------------

# Optional data.gov.sg API key, sent as x-api-key. Raises the real-time rate limit from 6 to 12 or 30 calls / 10 s.
DATA_GOV_SG_API_KEY=

# Optional NASA FIRMS MAP_KEY. Without it, the keyless regional 24h/48h/7d CSV files are used.
FIRMS_MAP_KEY=

# Optional persistence. Both must be set to enable database reads and writes.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Secret for the scheduled ingestion endpoint (/api/ingest). At least 16 characters.
# Without it, ingestion is disabled.
CRON_SECRET=

# Reserved for a future Malaysia DOE adapter. Setting it does not connect anything by itself.
MY_DOE_APIMS_ENDPOINT=

# Development only: add clearly labelled synthetic stations and detections. Ignored in production builds.
HAZE_DEMO_MODE=false
